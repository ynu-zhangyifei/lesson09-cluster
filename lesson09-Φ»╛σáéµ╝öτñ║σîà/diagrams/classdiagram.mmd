%% 类图：客户分群项目核心类（图即代码教学素材 · Mermaid）
%% 渲染：npx @mermaid-js/mermaid-cli -i classdiagram.mmd -o classdiagram.png
classDiagram
    class Customer {
        +int customer_id
        +int age
        +float income
        +float balance
        +int product_count
        +str gender
        +str city
        +int cluster
    }

    class DataLoader {
        +load(path: str) DataFrame
        +inspect(df) None
        +scatter_raw(df) None
    }

    class Preprocessor {
        +scaler: StandardScaler
        +fit_transform(X) ndarray
        +inverse_transform(X) ndarray
    }

    class ClusterModel {
        +k: int
        +random_state: int = 42
        +n_init: int = 10
        +fit(X) None
        +predict(X) ndarray
        +inertia_: float
        +cluster_centers_: ndarray
    }

    class KSelector {
        +elbow(X, k_range) list
        +silhouette(X, k_range) list
        +choose(X) int
    }

    class IterationDemo {
        +kmeanspp_init(X, k, rng) ndarray
        +lloyd_loop(X, centers) history
        +plot_iterations(history) None
    }

    class ReportGenerator {
        +summarize(df) DataFrame
        +name_clusters(summary) dict
        +write_markdown(path) None
    }

    DataLoader --> Customer : 读入
    Preprocessor ..> ClusterModel : 标准化后聚类
    KSelector ..> ClusterModel : 选 k
    ClusterModel --> Customer : 写回 cluster
    IterationDemo ..> ClusterModel : 过程可视化
    ReportGenerator --> Customer : 统计
